# ---------------------------------------------------------------- Secrets
# Never commit real keys. .env.example (empty values) is the only env file in git.
.env
.env.*
!.env.example
*.pem
*.key

# ----------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------- Data, models and outputs
# Keep datasets, checkpoints and run outputs out of git. Commit only small
# eval files you are allowed to share (see evals/README.md).
/data/
/runs/
*.pt
*.ckpt
*.safetensors
*.gguf

# --------------------------------------------------------- OS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
