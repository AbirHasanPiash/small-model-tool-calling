# Copy this file to .env and paste your keys after the = signs:
#   cp .env.example .env
# .env is ignored by git. This file is committed, so it must never hold a real key.
# Write values without quotes and without spaces around the = sign.

# Free LLM APIs (week 0 guide, Part 4)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=

# Tracing (Part 5). Use the URL of the region you signed up in:
# EU https://cloud.langfuse.com   US https://us.cloud.langfuse.com   JP https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: the model each check uses. See what your keys can use: make keys ARGS=--list
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=openrouter/free
# MISTRAL_MODEL=mistral-small-latest
